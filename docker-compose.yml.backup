version: '3.8'

services:
  web:
    build: .
    container_name: fieldtech-website
    ports:
      - "8000:8000"
    restart: unless-stopped

# Optional: Uncomment and configure the external network if you have nginx proxy manager running
# networks:
#   nginx_network:
#     external: true
#     name: nginxproxymanager_default  # Name of your nginx proxy manager network